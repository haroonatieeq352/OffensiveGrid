# ==========================================
# OffensiveGrid — Backend Environment Config
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-cszone-cybergrid-secret-key-development-2026-production-ready
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
# Leave blank to fallback gracefully to local SQLite in development mode
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=scenario-files

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Mock Payment / Flag Rate Limit
RATE_LIMIT_FLAG_SUBMIT=10/m
