# OffensiveGrid - Production Environment Variables
# Provide this file to the DevOps team as a reference.

# ==========================================
# Backend Variables
# ==========================================
DJANGO_SECRET_KEY="replace-this-with-a-very-secure-random-key"
ALLOWED_HOSTS="cszone.pk,www.cszone.pk,localhost"
CORS_ALLOWED_ORIGINS="https://cszone.pk,https://www.cszone.pk"
SECURE_SSL_REDIRECT="True"

# ==========================================
# Database Variables (PostgreSQL)
# ==========================================
DB_NAME="offensivegrid_prod"
DB_USER="offensivegrid_admin"
DB_PASSWORD="secure-db-password-here"

# ==========================================
# Frontend Variables
# ==========================================
HOST_PORT=80

# ==========================================
# Founder & Machine Authorization (Zero-Trust Gate)
# ==========================================
# Set to TRUE on Haroon Atieeq's official server for lifetime Founder authorization
OFFENSIVEGRID_FOUNDER_DEV="TRUE"
# Or provide a machine-specific license key:
# OFFENSIVEGRID_LICENSE_KEY="OGLIC.<payload>.<sig>"

