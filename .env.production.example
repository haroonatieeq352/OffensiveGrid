# OffensiveGrid - Production Environment Configuration Reference
# Duplicate this file as .env before running docker-compose in production.

# ==========================================
# 1. Security & Host Networking
# ==========================================
DJANGO_SECRET_KEY="generate-a-strong-50-character-secret-key-here"
ALLOWED_HOSTS="cszone.pk,www.cszone.pk,localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="https://cszone.pk,https://www.cszone.pk"
CSRF_TRUSTED_ORIGINS="https://cszone.pk,https://www.cszone.pk"
SECURE_SSL_REDIRECT="True"

# ==========================================
# 2. Database (Managed PostgreSQL / Supabase / Local Container)
# ==========================================
# When using local docker-compose db container:
DB_HOST="db"
DB_PORT="5432"
DB_NAME="cybergrid"
DB_USER="postgres"
DB_PASSWORD="your-strong-production-password-here"

# OR use a direct cloud connection string (e.g. Supabase, Neon, Cloud SQL):
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# ==========================================
# 3. Email & SMTP Configuration (Mandatory for OTPs)
# ==========================================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-16-character-app-password"
DEFAULT_FROM_EMAIL="OffensiveGrid <your-email@gmail.com>"

# ==========================================
# 4. Storage & Integrations (Supabase / Google OAuth)
# ==========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-key"
SUPABASE_BUCKET_NAME="scenario-files"
GOOGLE_CLIENT_ID="94519386927-56jthpamc8o6qgg5l5sn7sfguhdrigjr.apps.googleusercontent.com"

# ==========================================
# 5. Frontend Port Mapping
# ==========================================
HOST_PORT=80

# ==========================================
# 6. Founder & Zero-Trust Machine Authorization Gate
# ==========================================
# Set to TRUE on Haroon Atieeq's official server for lifetime Founder authorization
OFFENSIVEGRID_FOUNDER_DEV="TRUE"
# Or provide a machine-specific license key:
# OFFENSIVEGRID_LICENSE_KEY="OGLIC.<payload>.<sig>"
